# Environment Configuration for lg_deploy

# Checkpointer Configuration
# --------------------------
# Type of checkpointer to use for LangGraph state persistence
# Options: memory (default), redis, postgres
# Required packages:
#   - memory: No additional packages (built-in)
#   - redis: pip install langgraph-checkpoint-redis
#   - postgres: pip install langgraph-checkpoint-postgres
LG_CHECKPOINTER_TYPE=memory

# Connection string for database checkpointers
# For redis: redis://host:port (e.g., redis://localhost:6379)
# For postgres: postgresql://user:pass@host:port/dbname
LG_CHECKPOINTER_CONN_STRING=

# Example configurations:
# --------------------------
# Memory (development):
#   LG_CHECKPOINTER_TYPE=memory
#   # No conn_string needed

# Redis:
#   LG_CHECKPOINTER_TYPE=redis
#   LG_CHECKPOINTER_CONN_STRING=redis://localhost:6379
#   # Install: pip install langgraph-checkpoint-redis

# PostgreSQL:
#   LG_CHECKPOINTER_TYPE=postgres
#   LG_CHECKPOINTER_CONN_STRING=postgresql://user:password@localhost:5432/langgraph
#   # Install: pip install langgraph-checkpoint-postgres
